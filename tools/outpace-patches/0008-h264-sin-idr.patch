+/// MiVisor (parche 0008): emisiones H.264 de TV que nunca mandan IDR (NAL 5) ni
+/// `random_access_indicator`. Sin esto el empaquetador HLS no encuentra dónde empezar y la imagen
+/// no llega. Siempre se exige el SPS en el mismo paquete (el decodificador lo necesita para
+/// arrancar), así un I suelto a mitad de GOP no abre nada. Con SPS delante, es punto de entrada:
+/// - un corte I normal (NAL 1, `slice_type` 2/7, `first_mb_in_slice` 0): TV entrelazada, GOP abierto;
+/// - un SEI de punto de recuperación (tipo 6): refresco intra gradual, sin imágenes I enteras;
+/// - SPS + PPS cuando el corte no cabe en este paquete (SEI largos delante, p. ej. subtítulos):
+///   la cabecera del corte viene en el siguiente y no se puede mirar aquí.
+fn h264_sps_then_i_slice(elementary: &[u8]) -> bool {
+    let mut saw_sps = false;
+    let mut saw_pps = false;
+    let mut recovery_point = false;
+    let mut i = 0;
+    while i + 3 < elementary.len() {
+        if elementary[i] != 0 || elementary[i + 1] != 0 || elementary[i + 2] != 1 {
+            i += 1;
+            continue;
+        }
+        let nal = elementary[i + 3] & 0x1F;
+        match nal {
+            7 => saw_sps = true,
+            8 => saw_pps = true,
+            // SEI: el primer mensaje dice su tipo (sin bytes 0xFF de extensión: el 6 cabe en uno).
+            6 if elementary.get(i + 4) == Some(&6) => recovery_point = true,
+            1 | 5 if saw_sps => {
+                return recovery_point || h264_slice_is_first_i(&elementary[i + 4..]);
+            }
+            1 | 5 => return false,
+            _ => {}
+        }
+        i += 3;
+    }
+    // Sin corte visible en este paquete.
+    saw_sps && (saw_pps || recovery_point)
+}
+
+/// `first_mb_in_slice == 0` y `slice_type` I (2 o 7) al principio de una cabecera de corte.
+fn h264_slice_is_first_i(header: &[u8]) -> bool {
+    // Quita los bytes de prevención de emulación (00 00 03) de los primeros bytes.
+    let mut rbsp = Vec::with_capacity(8);
+    let mut zeros = 0;
+    for &b in header.iter().take(12) {
+        if zeros >= 2 && b == 3 {
+            zeros = 0;
+            continue;
+        }
+        zeros = if b == 0 { zeros + 1 } else { 0 };
+        rbsp.push(b);
+    }
+    let mut bit = 0usize;
+    let mut read_ue = || -> Option<u32> {
+        let get =
+            |pos: usize| -> Option<u8> { rbsp.get(pos / 8).map(|b| (*b >> (7 - pos % 8)) & 1) };
+        let mut lz = 0u32;
+        while get(bit)? == 0 {
+            lz += 1;
+            bit += 1;
+            if lz > 16 {
+                return None;
+            }
+        }
+        bit += 1;
+        let mut v = 0u32;
+        for _ in 0..lz {
+            v = (v << 1) | get(bit)? as u32;
+            bit += 1;
+        }
+        Some((1u32 << lz) - 1 + v)
+    };
+    matches!((read_ue(), read_ue()), (Some(0), Some(2 | 7)))
+}
