+#[cfg(test)]
+mod mivisor_h264_sin_idr {
+    use super::*;
+
+    fn pkt(pid: u16, es: &[u8]) -> Vec<u8> {
+        let mut p = vec![0x47, 0x40 | (pid >> 8) as u8, pid as u8, 0x10];
+        p.extend_from_slice(&[0, 0, 1, 0xE0, 0, 0, 0x80, 0x00, 0x00]);
+        p.extend_from_slice(es);
+        p.resize(TS_PACKET_LEN, 0xFF);
+        p
+    }
+
+    #[test]
+    fn mivisor_h264_sps_y_corte_i_es_punto_de_entrada() {
+        // AUD, SPS, PPS, SEI y corte I no-IDR (first_mb 0 -> '1', slice_type 7 -> '0001000').
+        let es = [
+            0,
+            0,
+            1,
+            0x09,
+            0x10,
+            0,
+            0,
+            1,
+            0x67,
+            0x64,
+            0,
+            0x28,
+            0,
+            0,
+            1,
+            0x68,
+            0xEE,
+            0,
+            0,
+            1,
+            0x06,
+            0x00,
+            0x01,
+            0x80,
+            0,
+            0,
+            1,
+            0x01,
+            0b1000_1000,
+            0x80,
+        ];
+        assert!(payload_has_irap(&pkt(0x100, &es), Some(VideoCodec::H264)));
+    }
+
+    #[test]
+    fn mivisor_h264_punto_de_recuperacion_y_corte_en_el_siguiente_paquete() {
+        // SPS + SEI de punto de recuperación + corte P (refresco intra): sí.
+        let refresh = [
+            0,
+            0,
+            1,
+            0x67,
+            0x64,
+            0,
+            0x28,
+            0,
+            0,
+            1,
+            0x06,
+            0x06,
+            0x01,
+            0x80,
+            0,
+            0,
+            1,
+            0x01,
+            0b1001_1000,
+        ];
+        assert!(payload_has_irap(
+            &pkt(0x100, &refresh),
+            Some(VideoCodec::H264)
+        ));
+        // SPS + PPS y un SEI largo: el corte no cabe en el paquete. Sí.
+        let mut long_sei = vec![
+            0, 0, 1, 0x67, 0x64, 0, 0x28, 0, 0, 1, 0x68, 0xEE, 0, 0, 1, 0x06, 0x04, 0xFF,
+        ];
+        long_sei.resize(170, 0x55);
+        assert!(payload_has_irap(
+            &pkt(0x100, &long_sei),
+            Some(VideoCodec::H264)
+        ));
+        // SPS + SEI normal (no de recuperación) sin corte visible ni PPS: no.
+        let sps_sei = [0, 0, 1, 0x67, 0x64, 0, 0x28, 0, 0, 1, 0x06, 0x04, 0x10];
+        assert!(!payload_has_irap(
+            &pkt(0x100, &sps_sei),
+            Some(VideoCodec::H264)
+        ));
+    }
+
+    #[test]
+    fn mivisor_h264_corte_p_o_i_sin_sps_no_abre() {
+        // Corte P (slice_type 5 -> '00110') con SPS: no.
+        let p_slice = [0, 0, 1, 0x67, 0x64, 0, 0x28, 0, 0, 1, 0x01, 0b1001_1000];
+        assert!(!payload_has_irap(
+            &pkt(0x100, &p_slice),
+            Some(VideoCodec::H264)
+        ));
+        // Corte I sin SPS delante: no (un I suelto a mitad de GOP).
+        let i_alone = [0, 0, 1, 0x09, 0x10, 0, 0, 1, 0x01, 0b1000_1000, 0x80];
+        assert!(!payload_has_irap(
+            &pkt(0x100, &i_alone),
+            Some(VideoCodec::H264)
+        ));
+        // SPS solo: sigue sin abrir.
+        let sps = [0, 0, 1, 0x67, 0x64, 0, 0x28];
+        assert!(!payload_has_irap(&pkt(0x100, &sps), Some(VideoCodec::H264)));
+    }
