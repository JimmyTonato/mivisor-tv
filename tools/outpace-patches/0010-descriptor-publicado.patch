         );
         assert_eq!(decode_transport_url("turl-@@@not-base64@@@"), None);
     }
+
+    #[test]
+    fn mivisor_tf_descriptor_en_el_id() {
+        let bytes = b"AceStreamTransport\x00\x01datos".to_vec();
+        let id = format!("tf-{}", Base64UrlUnpadded::encode_string(&bytes));
+        assert!(!id.contains('/') && !id.contains('?') && !id.contains(':'));
+        assert_eq!(decode_inline_transport(&id), Some(bytes));
+        assert_eq!(decode_inline_transport("tf-"), None);
+        assert_eq!(decode_inline_transport("tf-***"), None);
+        assert_eq!(decode_inline_transport("cid:0123"), None);
+        assert_eq!(decode_inline_transport("turl-aHR0cHM6Ly9oL3g"), None);
+    }
 }
