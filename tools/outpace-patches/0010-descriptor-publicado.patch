+/// MiVisor (parche 0010): prefijo de un descriptor que va DENTRO del id, en base64url sin relleno
+/// (`tf-<base64url(bytes AceStreamTransport)>`). Lo usa MiVisor TV con el descriptor que publica
+/// MiVisor Gold, para no pedirlo otra vez al catálogo. Como `turl-`, es un único segmento de ruta.
+const INLINE_PREFIX: &str = "tf-";
+
+/// Bytes del descriptor de un id `tf-…`; `None` si no lo es o el base64url no vale.
+pub(crate) fn decode_inline_transport(id: &str) -> Option<Vec<u8>> {
+    let b64 = id.strip_prefix(INLINE_PREFIX)?;
+    let bytes = Base64UrlUnpadded::decode_vec(b64).ok()?;
+    (!bytes.is_empty()).then_some(bytes)
+}
