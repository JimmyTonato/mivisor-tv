 }
 
+/// MiVisor (parche 0010): tamaño máximo de un descriptor que trae quien llama (`tf-…`).
+const MAX_INLINE_TRANSPORT: usize = 256 * 1024;
+
+/// MiVisor (parche 0010): abrir con un descriptor ya descargado (lo publica MiVisor Gold), sin
+/// pedirlo otra vez al catálogo con `/gettorrent`. Se decodifica igual que el del catálogo y se
+/// pregunta la emisión ACTUAL con `/checktorrent` (como el parche 0007), porque el descriptor
+/// puede ser «permanente» y su infohash calculado ser una emisión antigua. No se apunta en el
+/// índice de infohashes (como los descriptores por URL): lo aporta quien llama.
+pub async fn stream_info_from_inline_transport(bytes: &[u8]) -> Result<StreamInfo, ResolveError> {
+    if bytes.is_empty() || bytes.len() > MAX_INLINE_TRANSPORT {
+        return Err(ResolveError::Transport("inline transport size"));
+    }
+    let mut info = stream_info_from_transport(bytes)?;
+    match catalog_current_infohash(bytes).await {
+        Some(current) if current != info.infohash => {
+            eprintln!(
+                "outpace: [mivisor] descriptor publicado: emision actual {} (el descriptor daba {})",
+                hex::encode(current),
+                hex::encode(info.infohash)
+            );
+            info.infohash = current;
+        }
+        Some(_) => eprintln!("outpace: [mivisor] descriptor publicado: la emision del descriptor es la actual"),
+        None => eprintln!("outpace: [mivisor] descriptor publicado: checktorrent sin respuesta; se usa la del descriptor"),
+    }
+    Ok(info)
+}
+
 /// MiVisor (parche 0007): tiempo por servidor para `/checktorrent`.
 const CHECKTORRENT_TIMEOUT: Duration = Duration::from_secs(3);
 
