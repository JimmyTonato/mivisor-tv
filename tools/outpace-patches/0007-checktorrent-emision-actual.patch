+/// MiVisor (parche 0007): tiempo por servidor para `/checktorrent`.
+const CHECKTORRENT_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// MiVisor (parche 0007): infohash de la emisión actual de un descriptor, según el catálogo.
+/// Prueba los servidores en orden y se queda con la primera respuesta auténtica (misma firma de
+/// respuesta que `gettorrent`). `None` si ninguno responde bien: entonces vale el calculado.
+async fn catalog_current_infohash(transport: &[u8]) -> Option<[u8; 20]> {
+    let checksum = hex::encode(transport_file_hash(transport));
+    for (host, port) in catalog_hosts() {
+        let random = {
+            let mut rng = rand::rng();
+            rng.random_range(1..=i64::MAX as u64)
+        };
+        let params: Vec<(&str, String)> = vec![
+            ("_n", "3.2.11".to_string()),
+            ("_p", "linux".to_string()),
+            ("_r", random.to_string()),
+            ("_v", "3021100".to_string()),
+            ("a", "0".to_string()),
+            ("checksum", checksum.clone()),
+            ("d", "0".to_string()),
+            ("z", "0".to_string()),
+        ];
+        let fetched = tokio::time::timeout(
+            CHECKTORRENT_TIMEOUT,
+            fetch_catalog_xml(&host, port, "/checktorrent", &params),
+        )
+        .await;
+        match fetched {
+            Ok(Ok(body)) => match catalog_response_infohash(&body, random) {
+                Ok(infohash) => {
+                    eprintln!("outpace: [mivisor] checktorrent {host}:{port} responde");
+                    return Some(infohash);
+                }
+                Err(e) => eprintln!("outpace: [mivisor] checktorrent {host}:{port} no valida: {e:?}"),
+            },
+            Ok(Err(e)) => eprintln!("outpace: [mivisor] checktorrent {host}:{port} fallo: {e:?}"),
+            Err(_) => eprintln!("outpace: [mivisor] checktorrent {host}:{port} sin respuesta"),
+        }
+    }
+    None
+}
