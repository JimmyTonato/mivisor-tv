+/// MiVisor (parche 0007): firma de una consulta al catálogo con parámetros arbitrarios. Mismo
+/// esquema que [`catalog_query_signature`]: `clave=valor` ordenados por clave y unidos por `#`
+/// (valores sin codificar), más el secreto. Con `_n,_p,_r,_v,<param>` da exactamente lo mismo.
+fn catalog_params_signature(params: &[(&str, String)]) -> String {
+    let mut sorted: Vec<&(&str, String)> = params.iter().collect();
+    sorted.sort_by(|a, b| a.0.cmp(b.0));
+    let signed = sorted
+        .iter()
+        .map(|p| format!("{}={}", p.0, p.1))
+        .collect::<Vec<_>>()
+        .join("#");
+    let mut hasher = Sha1::new();
+    hasher.update(signed.as_bytes());
+    hasher.update(CATALOG_SIGNING_SECRET);
+    hex::encode(hasher.finalize())
+}
+
+/// MiVisor (parche 0007): GET firmado a un servidor del catálogo; devuelve el cuerpo.
+async fn fetch_catalog_xml(
+    host: &str,
+    port: u16,
+    path: &str,
+    params: &[(&str, String)],
+) -> Result<Vec<u8>, ResolveError> {
+    let signature = catalog_params_signature(params);
+    let mut url = reqwest::Url::parse("http://catalog.example.invalid/")
+        .expect("constant catalog URL");
+    url.set_path(path);
+    {
+        let mut query = url.query_pairs_mut();
+        for (k, v) in params {
+            query.append_pair(k, v);
+        }
+        query.append_pair("_s", &signature);
+    }
+    let target = format!("{}?{}", url.path(), url.query().expect("catalog query"));
+    let request = format!(
+        "GET {target} HTTP/1.1\r\nHost: {host}:{port}\r\nUser-Agent: outpace/0.1\r\nAccept: */*\r\nConnection: close\r\n\r\n"
+    );
+    let mut stream = TcpStream::connect((host, port))
+        .await
+        .map_err(|_| ResolveError::Catalog("catalog connect failed"))?;
+    stream
+        .write_all(request.as_bytes())
+        .await
+        .map_err(|_| ResolveError::Catalog("catalog write failed"))?;
+    let mut response = Vec::new();
+    let mut buf = [0u8; 4096];
+    loop {
+        let n = stream
+            .read(&mut buf)
+            .await
+            .map_err(|_| ResolveError::Catalog("catalog read failed"))?;
+        if n == 0 {
+            break;
+        }
+        if response.len() + n > 64 * 1024 {
+            return Err(ResolveError::Catalog("catalog response too large"));
+        }
+        response.extend_from_slice(&buf[..n]);
+    }
+    http_response_body(&response)
+}
