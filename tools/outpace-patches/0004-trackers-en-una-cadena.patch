+/// MiVisor (parche 0004): hay descriptores cuya lista `trackers` trae UNA entrada con todas las URL
+/// separadas por espacios o saltos de línea ("udp://a/announce udp://b/announce …"). Outpace la
+/// trataba como una sola URL de cientos de caracteres y la descartaba, así que el canal se quedaba
+/// sin ningún tracker. Separa cada entrada por espacios, comas y saltos de línea, quita repetidas y
+/// conserva el orden. Máximo 64.
+pub fn split_tracker_entries<I: IntoIterator<Item = String>>(entries: I) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for entry in entries {
+        for url in entry.split(|c: char| c.is_whitespace() || c == ',') {
+            let url = url.trim();
+            if !url.is_empty() && url.contains("://") && !out.iter().any(|u| u == url) && out.len() < 64 {
+                out.push(url.to_string());
+            }
+        }
+    }
+    out
+}
