+/// MiVisor (parche 0014): clave para no repetir trackers. Solo el esquema y el servidor (`host:puerto`)
+/// se comparan sin mayúsculas (RFC 3986 §6.2.2.1); la ruta, la consulta y los tokens se comparan tal cual,
+/// así `?token=AbC` y `?token=abc` son trackers distintos. Una barra final se ignora solo si no hay
+/// consulta (`/announce` = `/announce/`). Antes se pasaba TODA la URL a minúsculas y se podía perder una
+/// alternativa válida.
+fn tracker_dedup_key(url: &str) -> String {
+    let Some((scheme, rest)) = url.split_once("://") else {
+        return url.to_string();
+    };
+    let cut = rest
+        .find(|c: char| c == '/' || c == '?' || c == '#')
+        .unwrap_or(rest.len());
+    let (authority, tail) = rest.split_at(cut);
+    let tail = if tail.contains('?') || tail.contains('#') {
+        tail
+    } else {
+        tail.strip_suffix('/').unwrap_or(tail)
+    };
+    format!(
+        "{}://{}{}",
+        scheme.to_ascii_lowercase(),
+        authority.to_ascii_lowercase(),
+        tail
+    )
+}
+
 const MAX_DESCRIPTOR_TRACKERS: usize = 64;
 const TRACKER_SCHEMES: [&str; 3] = ["udp://", "http://", "https://"];
 
