+/// MiVisor: extra catalog hosts from `OUTPACE_CATALOG_HOSTS` (`ip:port,ip:port`), tried FIRST and in order;
+/// the built-in [`CATALOG_HOSTS`] stay as the fallback. Lets the embedding app update the list without a new
+/// engine build when the official catalog moves.
+const CATALOG_HOSTS_ENV: &str = "OUTPACE_CATALOG_HOSTS";
+const CATALOG_HOSTS_MAX: usize = 16;
+
+/// MiVisor: `OUTPACE_CATALOG_HOSTS_ONLY=1` skips the built-in hosts (to test one catalog host on its own).
+const CATALOG_HOSTS_ONLY_ENV: &str = "OUTPACE_CATALOG_HOSTS_ONLY";
+
+fn catalog_hosts() -> Vec<(String, u16)> {
+    let mut hosts = parse_catalog_hosts(std::env::var(CATALOG_HOSTS_ENV).ok().as_deref());
+    if std::env::var(CATALOG_HOSTS_ONLY_ENV).ok().as_deref() == Some("1") && !hosts.is_empty() {
+        return hosts;
+    }
+    for &(host, port) in CATALOG_HOSTS {
+        if !hosts.iter().any(|(h, p)| h == host && *p == port) {
+            hosts.push((host.to_string(), port));
+        }
+    }
+    hosts
+}
+
+/// Pure parse of `OUTPACE_CATALOG_HOSTS`: comma/space separated `ipv4:port`; invalid entries are skipped,
+/// duplicates removed, at most [`CATALOG_HOSTS_MAX`]. Only literal IPv4 addresses (no names, no DNS).
+fn parse_catalog_hosts(value: Option<&str>) -> Vec<(String, u16)> {
+    let mut out: Vec<(String, u16)> = Vec::new();
+    for item in value.unwrap_or("").split(|c: char| c == ',' || c.is_whitespace()) {
+        let Some((host, port)) = item.trim().rsplit_once(':') else { continue };
+        let Ok(ip) = host.parse::<std::net::Ipv4Addr>() else { continue };
+        let Ok(port) = port.parse::<u16>() else { continue };
+        if port == 0 || ip.is_unspecified() || ip.is_loopback() || ip.is_private() || ip.is_link_local() || ip.is_broadcast() {
+            continue;
+        }
+        let entry = (ip.to_string(), port);
+        if !out.contains(&entry) && out.len() < CATALOG_HOSTS_MAX {
+            out.push(entry);
+        }
+    }
+    out
+}
+
