+/// MiVisor (parche 0004): saca los trackers de un descriptor sea cual sea su forma.
+///
+/// Fuentes, en este orden y sin repetir: `trackers`, `announce-list` y `announce` (estilo torrent).
+/// Cada fuente puede ser una cadena o una lista, con listas dentro de listas (niveles BEP-12).
+/// Dentro de cada cadena se separan las URL:
+/// - por espacios, tabuladores, saltos de línea, comas, punto y coma o `|`;
+/// - y también cuando vienen pegadas sin separador (`udp://a/announceudp://b/announce`).
+///
+/// Cada URL se limpia: comillas y `<>` alrededor fuera, esquema en minúsculas, `host:puerto` sin
+/// esquema → `udp://host:puerto/announce`. Solo se quedan `udp://`, `http://` y `https://`
+/// (los `ws(s)://` son de WebTorrent y Outpace no los habla). Máximo 64, en el orden recibido.
+pub fn normalize_trackers(raw: &Bencode) -> Vec<String> {
+    let mut texts: Vec<String> = Vec::new();
+    for key in [&b"trackers"[..], b"announce-list", b"announce"] {
+        if let Some(v) = raw.get(key) {
+            collect_texts(v, 0, &mut texts);
+        }
+    }
+    let mut out: Vec<String> = Vec::new();
+    for text in texts {
+        for url in split_urls(&text) {
+            if let Some(url) = clean_tracker_url(&url) {
+                let key = url.trim_end_matches('/').to_ascii_lowercase();
+                if out.len() < MAX_DESCRIPTOR_TRACKERS
+                    && !out.iter().any(|u| u.trim_end_matches('/').to_ascii_lowercase() == key)
+                {
+                    out.push(url);
+                }
+            }
+        }
+    }
+    out
+}
+
+const MAX_DESCRIPTOR_TRACKERS: usize = 64;
+const TRACKER_SCHEMES: [&str; 3] = ["udp://", "http://", "https://"];
+
+/// Todas las cadenas de un valor (lista, lista de listas…), con profundidad acotada.
+fn collect_texts(v: &Bencode, depth: usize, out: &mut Vec<String>) {
+    match v {
+        Bencode::Bytes(b) => out.push(String::from_utf8_lossy(b).into_owned()),
+        Bencode::List(items) if depth < 4 => {
+            for item in items {
+                collect_texts(item, depth + 1, out);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Caracteres invisibles que a veces se cuelan al copiar listas (BOM, espacios de ancho cero).
+fn strip_invisible(s: &str) -> String {
+    s.chars()
+        .filter(|c| !matches!(c, '\u{feff}' | '\u{200b}' | '\u{200c}' | '\u{200d}' | '\u{2060}'))
+        .collect()
+}
+
+/// Decodifica `%XX` (y `+` como espacio). Bytes inválidos se dejan tal cual.
+fn percent_decode(s: &str) -> String {
+    let b = s.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        match b[i] {
+            b'%' if i + 2 < b.len() => {
+                let hex = std::str::from_utf8(&b[i + 1..i + 3]).ok().and_then(|h| u8::from_str_radix(h, 16).ok());
+                match hex {
+                    Some(v) => {
+                        out.push(v);
+                        i += 3;
+                    }
+                    None => {
+                        out.push(b'%');
+                        i += 1;
+                    }
+                }
+            }
+            b'+' => {
+                out.push(b' ');
+                i += 1;
+            }
+            c => {
+                out.push(c);
+                i += 1;
+            }
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// Trackers de un enlace magnet (`tr=`, `tr.1=`…, codificados) — algunas listas los pegan tal cual.
+fn magnet_trackers(magnet: &str) -> Vec<String> {
+    let query = magnet.split_once('?').map(|(_, q)| q).unwrap_or("");
+    query
+        .split('&')
+        .filter_map(|kv| kv.split_once('='))
+        .filter(|(k, _)| {
+            let k = k.to_ascii_lowercase();
+            k == "tr" || k.starts_with("tr.")
+        })
+        .map(|(_, v)| percent_decode(v))
+        .collect()
+}
+
+/// Parte una cadena en posibles URL: por separadores y por cada comienzo de esquema.
+fn split_urls(text: &str) -> Vec<String> {
+    let text = strip_invisible(text);
+    let mut out = Vec::new();
+    for piece in text.split(|c: char| c.is_whitespace() || matches!(c, ',' | ';' | '|' | '\0')) {
+        if piece.is_empty() {
+            continue;
+        }
+        let lower = piece.to_ascii_lowercase();
+        if lower.starts_with("magnet:") {
+            for tr in magnet_trackers(piece) {
+                out.extend(split_urls(&tr));
+            }
+            continue;
+        }
+        if lower.contains("%3a%2f%2f") {
+            // URL codificada entera («udp%3A%2F%2Fhost%3A80%2Fannounce»).
+            out.extend(split_urls(&percent_decode(piece)));
+            continue;
+        }
+        let piece = piece.strip_prefix("tr=").unwrap_or(piece);
+        // Cortes donde empieza otro esquema dentro de la misma pieza (URL pegadas).
+        let lower = piece.to_ascii_lowercase();
+        let mut cuts: Vec<usize> = Vec::new();
+        for scheme in ["udp://", "http://", "https://", "ws://", "wss://"] {
+            let mut from = 0;
+            while let Some(i) = lower[from..].find(scheme) {
+                let at = from + i;
+                // «https://» contiene «http» pero no «http://» en la misma posición; evita doble corte.
+                if at > 0 && !cuts.contains(&at) {
+                    cuts.push(at);
+                }
+                from = at + scheme.len();
+            }
+        }
+        cuts.sort_unstable();
+        let mut start = 0;
+        for cut in cuts {
+            if cut > start && piece.is_char_boundary(cut) {
+                out.push(piece[start..cut].to_string());
+                start = cut;
+            }
+        }
+        out.push(piece[start..].to_string());
+    }
+    out
+}
+
+/// Limpia una URL de tracker; `None` si no sirve.
+fn clean_tracker_url(raw: &str) -> Option<String> {
+    let s = raw.trim().trim_matches(|c: char| matches!(c, '"' | '\'' | '<' | '>' | '(' | ')' | '[' | ']'));
+    if s.is_empty() || s.len() > 256 || s.chars().any(char::is_control) {
+        return None;
+    }
+    let lower = s.to_ascii_lowercase();
+    if let Some(scheme) = TRACKER_SCHEMES.iter().find(|p| lower.starts_with(**p)) {
+        let rest = &s[scheme.len()..];
+        if rest.is_empty() || rest.starts_with('/') {
+            return None;
+        }
+        return Some(format!("{scheme}{rest}"));
+    }
+    if lower.contains("://") {
+        return None; // ws(s)://, magnet:, etc.
+    }
+    // «host:puerto[/ruta]» sin esquema → UDP, que es lo que usa Ace Stream.
+    let host_port = s.split('/').next().unwrap_or(s);
+    let (host, port) = host_port.rsplit_once(':')?;
+    if host.is_empty() || host.contains(' ') || port.parse::<u16>().ok().filter(|p| *p > 0).is_none() {
+        return None;
+    }
+    let path = &s[host_port.len()..];
+    Some(format!("udp://{host_port}{}", if path.is_empty() { "/announce" } else { path }))
+}
